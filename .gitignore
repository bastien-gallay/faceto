/target
**/*.rs.bk

# generated boards live next to the model file
board.svg
index.html
comments.jsonl

# editor / OS
.DS_Store
/.idea
/.vscode
*.swp
*.swo

# personal notes (not part of the project)
/.personal/

# Claude Code per-machine state (worktrees, local settings) — never shared.
# Keep shared project settings.json + path-scoped rules trackable via the negations.
/.claude/*
!/.claude/settings.json
!/.claude/rules/

# impeccable design-skill per-machine cache (design.json is shared, this is not)
.impeccable/hook.cache.json

# local serve log
/serve.log

# cargo-mutants run output (transient)
/mutants.out/

# typst briefs are tracked as .typ source; the rendered PDF is derived
docs/*.pdf
